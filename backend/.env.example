# Copy to backend/.env and adjust. Every value has a sensible default.

# --- General ---------------------------------------------------------------
LOG_LEVEL=INFO
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- HTTP fetching -----------------------------------------------------------
# Identify your deployment honestly and include a contact URL or email.
# Many sites (e.g. Wikimedia) reject clients that impersonate browsers or omit contact info.
USER_AGENT=ImageExtractor/1.0 (+https://example.com/imageextractor-bot)
HTTP_CONNECT_TIMEOUT=10
HTTP_READ_TIMEOUT=20
HTTP_RETRIES=2
HTTP_RETRY_BACKOFF=0.5
MAX_REDIRECTS=5
MAX_HTML_BYTES=5242880
MAX_CSS_BYTES=2097152
MAX_STYLESHEETS=10

# --- Security ----------------------------------------------------------------
ALLOWED_PORTS=80,443,8080,8443
MAX_URL_LENGTH=2048
# Local testing only. NEVER enable in production: disables SSRF protection.
ALLOW_PRIVATE_NETWORKS=false

# --- Images ------------------------------------------------------------------
MAX_IMAGE_BYTES=15728640
MAX_JOB_TOTAL_BYTES=314572800
MAX_IMAGES_PER_JOB=300
MAX_CONCURRENT_DOWNLOADS=8
MIN_IMAGE_DIMENSION=3
MAX_IMAGE_PIXELS=100000000

# --- Selenium (headless Chrome) ------------------------------------------------
MAX_BROWSER_SESSIONS=2
SELENIUM_PAGE_LOAD_TIMEOUT=30
SELENIUM_SCRIPT_TIMEOUT=15
SELENIUM_MAX_SCROLLS=15
SELENIUM_SCROLL_WAIT=1.5
SELENIUM_SCROLL_BUDGET=15
SELENIUM_MAX_BG_ELEMENTS=5000
BROWSER_FALLBACK_MIN_IMAGES=3
# Optional: custom Chrome binary / chromedriver. Leave empty to let Selenium Manager handle it.
CHROME_BINARY=
CHROMEDRIVER_PATH=
# Optional: override headless Chrome's User-Agent (default: Chrome's own)
BROWSER_USER_AGENT=

# --- Jobs ----------------------------------------------------------------------
MAX_CONCURRENT_JOBS=4
JOB_TTL_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=120
# Where per-job image caches are stored (default: <system temp>/image_extractor)
# TEMP_DIR=
